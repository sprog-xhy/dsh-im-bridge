# Copy to .env and fill in; load into the environment before running the bridge.
# (The bridge reads these directly from the environment, prefixed DSH_IM_BRIDGE_.)

# ---- dsh ----
DSH_IM_BRIDGE_DSH_BASE_URL=http://127.0.0.1:10010

# ---- Feishu ----
DSH_IM_BRIDGE_FEISHU_BASE_URL=https://open.feishu.cn    # 国际版 Lark 用 https://open.larksuite.com
# Custom bot webhook (send-only):
DSH_IM_BRIDGE_FEISHU_WEBHOOK_URL=
# Two-way app bot:
DSH_IM_BRIDGE_FEISHU_APP_ID=
DSH_IM_BRIDGE_FEISHU_APP_SECRET=
DSH_IM_BRIDGE_FEISHU_ENCRYPT_KEY=

# ---- QQ (OneBot11) ----
DSH_IM_BRIDGE_QQ_WS_URL=ws://127.0.0.1:3001
DSH_IM_BRIDGE_QQ_ACCESS_TOKEN=

# ---- QQ 官方开放平台机器人 API (q.qq.com) ----
DSH_IM_BRIDGE_QQ_OFFICIAL_APP_ID=
DSH_IM_BRIDGE_QQ_OFFICIAL_APP_SECRET=
DSH_IM_BRIDGE_QQ_OFFICIAL_SANDBOX=false
# DSH_IM_BRIDGE_QQ_OFFICIAL_BASE_URL=   # optional: custom API root (testing)

# ---- WOA (WPS 协作) ----
DSH_IM_BRIDGE_WOA_APP_ID=
DSH_IM_BRIDGE_WOA_SECRET_KEY=
DSH_IM_BRIDGE_WOA_ENCRYPT_KEY=
DSH_IM_BRIDGE_WOA_API_URL=https://openapi.wps.cn
